# Copy this file to .env and fill in real values. .env is gitignored.
DB_USER=shop_owner
DB_PASSWORD=change-me
DB_NAME=shop
HOST_PORT=5432

# Used by the app service (docker-compose) - point at the readonly role,
# NOT the owner role above, once you've created it (see db/schema.sql).
DATABASE_URL=postgresql://readonly:change-me-too@postgres_db:5432/shop
