# IntelSphere settings from the user's API Platform screenshot.
# Copy to .env.llm, then paste the full key into that local ignored file.
LLM_PROVIDER=kku-intelsphere
LLM_BASE_URL=https://gen.ai.kku.ac.th/api/v1
# Verified against the provider's /models response during implementation.
LLM_MODEL=gpt-5.6-luna
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=45
